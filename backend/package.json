{
  "name": "chatbit-backend",
  "version": "1.0.0",
  "description": "ChatBit real-time customer support API (Express + Socket.IO + PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f src/db/seed.sql"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.4.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
